%{
/*
 * mpl.l - Lexical analyzer for MPL (My Programming Language)
 *
 * This file is #included at the bottom of mpl.y, so the token names
 * (START, NUM, IDENT, ...) come from the parser generated by yacc.
 */
#include <stdio.h>
#include <stdlib.h>

int line_no = 1;          /* current line, used in error messages */
static void lex_error(const char *msg);
%}

%option noyywrap
%option noinput
%option nounput

/* ---------- Regular definitions ---------- */
LETTER      [a-zA-Z]
DIGIT       [0-9]
IDENT       {LETTER}({LETTER}|{DIGIT}|_)*
INTEGER     {DIGIT}+
REAL        {DIGIT}+"."{DIGIT}+
CHARCONST   \'([^'\\\n]|\\[ntr0\\'])\'
STRING      \"([^"\\\n]|\\.)*\"
WS          [ \t\r]+

%x BLOCK_COMMENT

%%

 /* ---------- Comments ---------- */
"##".*                  { /* line comment: ignore to end of line */ }
"#*"                    { BEGIN(BLOCK_COMMENT); }
<BLOCK_COMMENT>"*#"     { BEGIN(INITIAL); }
<BLOCK_COMMENT>\n       { line_no++; }
<BLOCK_COMMENT>.        { /* skip comment text */ }
<BLOCK_COMMENT><<EOF>>  { lex_error("unterminated block comment (missing *#)"); }

 /* ---------- Keywords (must come before IDENT) ---------- */
"start"         { return START; }
"finish"        { return FINISH; }
"num"           { return NUM; }
"real"          { return REAL_T; }
"letter"        { return LETTER_T; }
"flag"          { return FLAG; }
"text"          { return TEXT_T; }
"yes"           { return YES; }
"no"            { return NO; }
"when"          { return WHEN; }
"then"          { return THEN; }
"orwhen"        { return ORWHEN; }
"otherwise"     { return OTHERWISE; }
"endwhen"       { return ENDWHEN; }
"while"         { return WHILE; }
"do"            { return DO; }
"endwhile"      { return ENDWHILE; }
"repeat"        { return REPEAT; }
"until"         { return UNTIL; }
"show"          { return SHOW; }
"ask"           { return ASK; }
"and"           { return AND; }
"or"            { return OR; }
"not"           { return NOT; }

 /* ---------- Multi-character operators ---------- */
"<-"            { return ASSIGN; }
"<="            { return LE; }
">="            { return GE; }
"<>"            { return NE; }

 /* ---------- Single-character operators and punctuation ---------- */
"="             { return EQ; }
"<"             { return LT; }
">"             { return GT; }
"+"             { return '+'; }
"-"             { return '-'; }
"*"             { return '*'; }
"/"             { return '/'; }
"%"             { return '%'; }
"^"             { return '^'; }
"("             { return '('; }
")"             { return ')'; }
","             { return ','; }
";"             { return ';'; }
":"             { return ':'; }

 /* ---------- Constants and identifiers ---------- */
{REAL}          { return REAL_CONST; }
{INTEGER}       { return INT_CONST; }
{CHARCONST}     { return CHAR_CONST; }
{STRING}        { return STRING_CONST; }
{IDENT}         { return IDENT; }

 /* ---------- Whitespace ---------- */
{WS}            { /* ignore */ }
\n              { line_no++; }

 /* ---------- Anything else is a lexical error ---------- */
\"[^"\n]*       { lex_error("unterminated text constant"); }
\'[^\n]?        { lex_error("bad letter constant (use 'a', '\\n', ...)"); }
.               { lex_error("unknown character"); }

%%

static void lex_error(const char *msg)
{
    if (yytext[0] != '\0')
        printf("Lexical error at line %d near '%s': %s\n", line_no, yytext, msg);
    else
        printf("Lexical error at line %d: %s\n", line_no, msg);
    exit(1);
}
